{
  "theme": "default",
  "frameRate": 60,
  "enableDoubleBuffering": true,
  "enableInputLogging": false,
  "components": {
    "button": {
      "defaultWidth": 12,
      "defaultHeight": 3,
      "normalColors": "primary",
      "focusColors": "focus"
    },
    "textBox": {
      "defaultWidth": 20,
      "defaultHeight": 1,
      "maxLength": 256
    },
    "listBox": {
      "defaultWidth": 30,
      "defaultHeight": 10
    }
  },
  "colors": {
    "primary": "White:Black",
    "secondary": "Gray:Black",
    "focus": "Black:White",
    "success": "Green:Black",
    "warning": "Yellow:Black",
    "error": "Red:Black"
  }
}