{
  "window": {
    "width": 120,
    "height": 40,
    "title": "WaffleTUI Enhanced",
    "resizable": true,
    "centerOnStart": true
  },
  "rendering": {
    "doubleBuffering": true,
    "partialRendering": true,
    "targetFps": 60,
    "vsync": true,
    "renderStats": false,
    "optimizeForTerminal": "auto"
  },
  "theme": {
    "current": "dark",
    "customThemesPath": "./themes",
    "themes": {
      "dark": {
        "name": "Dark Theme",
        "author": "WaffleTUI",
        "colors": {
          "primary": "Cyan",
          "secondary": "DarkBlue",
          "accent": "Yellow",
          "success": "Green",
          "warning": "Yellow",
          "error": "Red",
          "text": "White",
          "background": "Black",
          "border": "Gray"
        },
        "borders": {
          "style": "Single",
          "roundedCorners": false,
          "thickness": 1
        },
        "animations": {
          "enabled": true,
          "duration": 0.3,
          "easing": "EaseOut"
        }
      },
      "light": {
        "name": "Light Theme",
        "author": "WaffleTUI",
        "colors": {
          "primary": "DarkBlue",
          "secondary": "Gray",
          "accent": "DarkCyan",
          "success": "DarkGreen",
          "warning": "DarkYellow",
          "error": "DarkRed",
          "text": "Black",
          "background": "White",
          "border": "DarkGray"
        },
        "borders": {
          "style": "Single",
          "roundedCorners": true,
          "thickness": 1
        },
        "animations": {
          "enabled": true,
          "duration": 0.2,
          "easing": "EaseOut"
        }
      }
    }
  },
  "input": {
    "mouseSupport": false,
    "inputBufferSize": 10,
    "repeatDelay": 500,
    "repeatInterval": 50,
    "keyBindings": {
      "exit": "Ctrl+Q",
      "navigateNext": "Tab",
      "navigatePrevious": "Shift+Tab",
      "confirm": "Enter",
      "cancel": "Escape",
      "screenshot": "F12",
      "toggleStats": "F11"
    }
  },
  "behavior": {
    "autoSave": true,
    "saveInterval": 30000,
    "confirmExit": true,
    "reloadOnConfigChange": true,
    "culture": "en-US",
    "timezone": "UTC"
  },
  "plugins": {
    "enabled": true,
    "pluginsPath": "./plugins",
    "autoLoad": true,
    "allowedExtensions": [".dll", ".so", ".dylib"]
  },
  "logging": {
    "level": "Warning",
    "file": "waffletui.log",
    "maxFileSize": 10485760,
    "retainedFileCount": 5,
    "consoleOutput": true
  }
}